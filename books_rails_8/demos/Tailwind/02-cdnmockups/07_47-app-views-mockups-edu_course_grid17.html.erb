        <a href="#" class="hover:bg-gray-700 p-2 rounded">UbuntuDream</a>
        <a href="#" class="hover:bg-gray-700 p-2 rounded">Search</a>
        <a href="#" class="hover:bg-gray-700 p-2 rounded">Favorites</a>
        <a href="#" class="hover:bg-gray-700 p-2 rounded">Messages</a>
        <div class="relative" id="profileMenu">
