<%# Riassunto dello stato attuale:
  navbar_top: fissa in alto, stile icona + testo, visibile sempre.
  navbar_lateral: visibile solo su desktop, fissa a sinistra, non richiamabile da mobile.
  navbar_bottom: visibile solo su mobile, fissa in basso, stile identico alla top.
  main: spazio centrale correttamente con padding per evitare che il contenuto venga coperto.
%>
