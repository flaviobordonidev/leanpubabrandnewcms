<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Three Navbars Example</title>

    <!-- IMPORTA TAILWIND -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- CONFIGURA IL DARK MODE PER USARE LA CLASSE "dark" -->
    <script>
      tailwind.config = {
        darkMode: 'class',
      }
    </script>

  </head>
  <body class="bg-neutral-200 text-black mb-20">

    <!-- Main Content -->
    <main>

      <div class="flex w-full gap-6">

        <!-- card -->
        <div class="bg-white rounded overflow-hidden shadow-md">
          <img class="w-full h-32 object-cover" src="https://images.pexels.com/photos/1058035/pexels-photo-1058035.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="curry">
          <div>
            <span class="font-bold">Spezie</span>
            <span class="block text-sm">Una selezione di spezie</span>
          </div>
          <!-- badge -->
          <div>
            <span>12 min</span>
          </div>
        </div>
        <!-- card - end -->

        <!-- card -->
        <div class="bg-white rounded overflow-hidden shadow-md">
          <img class="w-full h-32 object-cover" src="https://images.pexels.com/photos/1058035/pexels-photo-1058035.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="curry">
          <div>
            <span class="font-bold">Spezie</span>
            <span class="block text-sm">Una selezione di spezie</span>
          </div>
          <!-- badge -->
          <div>
            <span>12 min</span>
          </div>
        </div>
        <!-- card - end -->

        <!-- card -->
        <div class="bg-white rounded overflow-hidden shadow-md">
          <img class="w-full h-32 object-cover" src="https://images.pexels.com/photos/1058035/pexels-photo-1058035.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="curry">
          <div>
            <span class="font-bold">Spezie</span>
            <span class="block text-sm">Una selezione di spezie molto molto molto molto molto moto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto saporite</span>
          </div>
          <!-- badge -->
          <div>
            <span>12 min</span>
          </div>
        </div>
        <!-- card - end -->

        <!-- card -->
        <div class="bg-white rounded overflow-hidden shadow-md">
          <img class="w-full h-32 object-cover" src="https://images.pexels.com/photos/1058035/pexels-photo-1058035.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="curry">
          <div>
            <span class="font-bold">Spezie</span>
            <span class="block text-sm">Una selezione di spezie molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto</span>
          </div>
          <!-- badge -->
          <div>
            <span>12 min</span>
          </div>
        </div>
        <!-- card - end -->

      </div>

      <h4 class="my-4">Latest Recipes</h4>

      <!-- Grid container of the cards -->
      <div class="grid md:grid-cols-3 gap-6">
        <!-- cards go here -->
        <!-- overflow-hidden fa in modo che tutto quello che esce dallo spazio del div sia nascosto. Questo evita che l'immagine fuoriesca con gli angoli non arrotondati. -->
        <div class="bg-white dark:bg-neutral-700 rounded overflow-hidden shadow-md dark:shadow-neutral-500/50 relative">
          <!-- w-full allunga l'immagine per tutta la larghezza dell'elemento che la contiene -->
          <!-- h-32 fissa l'altezza a 32 evitando che l'immagine allargandosi aumenti troppo in altezza -->
          <!-- object-cover evita che l'immagine sia allungata ("stretched") -->
          <img src="https://images.pexels.com/photos/674574/pexels-photo-674574.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="stew" class="w-full h-32 sm:h-48 object-cover">
          <div class="m-4">
            <span class="font-bold">5 Bean Chili Stew molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto molto moltomolto molto molto molto molto moltomolto molto molto molto molto moltomolto molto molto molto molto molto saporiti</span>
            <!-- block fa in modo che vada sulla seconda linea (in pratica è come se non ci fosse lo <span> che di default è "inline") -->
            <span class="block text-sm">Recipe by Mario</span>
          </div>
          <div class="bg-amber-400 text-amber-800 text-xs uppercase text-bold rounded-full p-2 absolute top-0 ml-2 mt-2">
            <svg class="inline-block" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-play-btn" viewBox="0 0 16 16">
              <path d="M6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814z"/>
              <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm15 0a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1z"/>
            </svg>
            <span>25 min</span>
          </div>
        </div>

        <div class="bg-white dark:bg-neutral-700 rounded overflow-hidden shadow-md dark:shadow-neutral-500/50 relative isolate">
          <img src="https://images.pexels.com/photos/674576/pexels-photo-674576.jpeg" alt="noodles" class="w-full h-32 sm:h-48 object-cover">
          <div class="m-4">
            <!-- https://tailwindcss.com/build-uis-that-dont-suck -->
            <a class="font-bold" href="#"><span class="absolute inset-0 z-10 hover:bg-neutral-100/10"></span>Veg Noodles</a>
            <span class="block text-sm">Recipe by Mario</span>
          </div>
          <div class="bg-amber-400 text-amber-800 text-xs uppercase text-bold rounded-full p-2 absolute top-0 ml-2 mt-2">
            <svg class="inline-block" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-alarm" viewBox="0 0 16 16">
              <path d="M8.5 5.5a.5.5 0 0 0-1 0v3.362l-1.429 2.38a.5.5 0 1 0 .858.515l1.5-2.5A.5.5 0 0 0 8.5 9z"/>
              <path d="M6.5 0a.5.5 0 0 0 0 1H7v1.07a7.001 7.001 0 0 0-3.273 12.474l-.602.602a.5.5 0 0 0 .707.708l.746-.746A6.97 6.97 0 0 0 8 16a6.97 6.97 0 0 0 3.422-.892l.746.746a.5.5 0 0 0 .707-.708l-.601-.602A7.001 7.001 0 0 0 9 2.07V1h.5a.5.5 0 0 0 0-1zm1.038 3.018a6 6 0 0 1 .924 0 6 6 0 1 1-.924 0M0 3.5c0 .753.333 1.429.86 1.887A8.04 8.04 0 0 1 4.387 1.86 2.5 2.5 0 0 0 0 3.5M13.5 1c-.753 0-1.429.333-1.887.86a8.04 8.04 0 0 1 3.527 3.527A2.5 2.5 0 0 0 13.5 1"/>
            </svg>
            <span>25 min</span>
          </div>
        </div>

        <div class="bg-white dark:bg-neutral-700 rounded overflow-hidden shadow-md dark:shadow-neutral-500/50 relative">
          <img src="https://images.pexels.com/photos/1618955/pexels-photo-1618955.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="curry" class="w-full h-32 sm:h-48 object-cover">
          <div class="m-4">
            <span class="font-bold">Tofu curry</span>
            <span class="block text-sm">Recipe by Mario</span>
          </div>
          <div class="bg-amber-400 text-amber-800 text-xs uppercase text-bold rounded-full p-2 absolute top-0 ml-2 mt-2">
            <svg class="inline-block" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-alarm" viewBox="0 0 16 16">
              <path d="M8.5 5.5a.5.5 0 0 0-1 0v3.362l-1.429 2.38a.5.5 0 1 0 .858.515l1.5-2.5A.5.5 0 0 0 8.5 9z"/>
              <path d="M6.5 0a.5.5 0 0 0 0 1H7v1.07a7.001 7.001 0 0 0-3.273 12.474l-.602.602a.5.5 0 0 0 .707.708l.746-.746A6.97 6.97 0 0 0 8 16a6.97 6.97 0 0 0 3.422-.892l.746.746a.5.5 0 0 0 .707-.708l-.601-.602A7.001 7.001 0 0 0 9 2.07V1h.5a.5.5 0 0 0 0-1zm1.038 3.018a6 6 0 0 1 .924 0 6 6 0 1 1-.924 0M0 3.5c0 .753.333 1.429.86 1.887A8.04 8.04 0 0 1 4.387 1.86 2.5 2.5 0 0 0 0 3.5M13.5 1c-.753 0-1.429.333-1.887.86a8.04 8.04 0 0 1 3.527 3.527A2.5 2.5 0 0 0 13.5 1"/>
            </svg>
            <span>25 min</span>
          </div>
        </div>

        <article class="bg-white dark:bg-neutral-700 rounded overflow-hidden shadow-md dark:shadow-neutral-500/50 relative">
          <img src="https://images.pexels.com/photos/1058035/pexels-photo-1058035.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="curry" class="w-full h-32 sm:h-48 object-cover">
          <header class="m-4">
            <span class="font-bold">Tofu curry</span>
            <span class="block text-sm">Recipe by Mario</span>
          </header>
          <aside class="bg-amber-400 text-amber-800 text-xs uppercase text-bold rounded-full p-2 absolute top-0 ml-2 mt-2">

            <svg class="inline-block h-4" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M280-80v-366q-51-14-85.5-56T160-600v-280h80v280h40v-280h80v280h40v-280h80v280q0 56-34.5 98T360-446v366zm400 0v-320H560v-280q0-83 58.5-141.5T760-880v800z"/></svg>
            <!--<svg class="inline-block" width="12" height="24" xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd" clip-rule="evenodd"><path d="M18.496 24h-.001c-.715 0-1.5-.569-1.5-1.5v-8.5s-1.172-.003-2.467 0c.802-6.996 3.103-14 4.66-14 .447 0 .804.357.807.851.01 1.395.003 16.612.001 21.649 0 .828-.672 1.5-1.5 1.5zm-11.505-12.449c0-.691-.433-.917-1.377-1.673-.697-.56-1.177-1.433-1.088-2.322.252-2.537.862-7.575.862-7.575h.6v6h1.003l.223-6h.607l.173 6h1.003l.242-6h.562l.199 6h1.003v-6h.549s.674 5.005.951 7.55c.098.902-.409 1.792-1.122 2.356-.949.751-1.381.967-1.381 1.669v10.925c0 .828-.673 1.5-1.505 1.5-.831 0-1.504-.672-1.504-1.5v-10.93z"/></svg>-->
            <!--<svg class="inline-block" width="24" height="24" xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd" clip-rule="evenodd"><path d="M5 12c0-2.896 1.01-3.553 4-7h6c3.076 3.55 4 4.083 4 7v10c0 1.105-.895 2-2 2h-10c-1.105 0-2-.895-2-2v-10zm12 0h-10v8h10v-8zm-4 3h2v2h-2v2h-2v-2h-2v-2h2v-2h2v2zm3-11h-8v-3c0-.552.448-1 1-1h6c.552 0 1 .448 1 1v3z"/></svg>-->
            <!--<svg class="inline-block h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-utensils-icon lucide-utensils"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>-->
            <span>25 min</span>
          </aside>
        </article>

        <div class="mx-auto max-w-md overflow-hidden rounded-xl bg-white shadow-md md:max-w-2xl">
          <div class="md:flex">
            <div class="md:shrink-0">
              <img
                class="h-48 w-full object-cover md:h-full md:w-48"
                src="https://images.pexels.com/photos/1058035/pexels-photo-1058035.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2"
                alt="Modern building architecture"
              />
            </div>
            <div class="p-8">
              <div class="text-sm font-semibold tracking-wide text-indigo-500 uppercase">Company retreats</div>
              <a href="#" class="mt-1 block text-lg leading-tight font-medium text-black hover:underline">
                Incredible accommodation for your team
              </a>
              <p class="mt-2 text-gray-500">
                Looking to take your team away on a retreat to enjoy awesome food and take in some sunshine? We have a list of
                places to do just that. BlablbLblbLBlblbL Bla bla bla bla bla.
              </p>
            </div>
          </div>
        </div>

        <!--
          Icons libraries testate e belle (prendono anche il colore impostato in tailwind)
          Per usare stesso colore impostato su Tailwind basta aggiungere -> fill="currentColor"
          https://icons.getbootstrap.com/
          https://lucide.dev/icons
          https://composeicons.com/icons/material-symbols/outlined/restaurant

          Alternative
          https://fontawesome.com/icons/utensils?f=classic&s=solid
          https://iconmonstr.com/?s=fork   (non funziona il preview nel sito ma le icone ci sono)
          -->
      </div>
    </main>

  </body>
</html>