    <script>
      // Tema
      function applyTheme(theme) {
        const root = document.documentElement;
        root.classList.remove('light', 'dark');

        if (theme === 'auto') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        root.classList.add(theme);
        localStorage.setItem('theme', theme);
        highlightActiveTheme(theme);
      }

      function setTheme(theme) {
        localStorage.setItem('theme', theme);
        applyTheme(theme);
      }

      function highlightActiveTheme(theme) {
        document.querySelectorAll('.theme-button').forEach(btn => {
          const btnTheme = btn.textContent.trim().toLowerCase();
          btn.classList.toggle('bg-red-100', btnTheme === theme);
          btn.classList.toggle('text-blue-700', btnTheme === theme);
          btn.classList.toggle('font-semibold', btnTheme === theme);
          btn.classList.toggle('dark:bg-blue-900', btnTheme === theme);
          btn.classList.toggle('dark:text-blue-300', btnTheme === theme);
        });
      }

      // Dropdown del profilo
      //function toggleDropdown() {
      //  document.getElementById('dropdownMenu').classList.toggle('hidden');
      //  document.getElementById('profilebutton').classList.add('bg-red', 'dark:bg-yellow'); // <-- verifica se queste classi sono corrette
      //}

      function toggleDropdown() {
        const dropdown = document.getElementById('dropdownMenu');
        const button = document.getElementById('profilebutton');
        const isOpen = !dropdown.classList.contains('hidden');

        if (isOpen) {
          dropdown.classList.add('hidden');
          button.classList.remove(
            'bg-neutral-800',
            'text-neutral-50',
            'dark:bg-neutral-50',
            'dark:text-neutral-800'
          );
        } else {
          dropdown.classList.remove('hidden');
          button.classList.add(
            'bg-neutral-800',
            'text-neutral-50',
            'dark:bg-neutral-50',
            'dark:text-neutral-800'
          );
        }
      }


      // Chiudi dropdown cliccando fuori
      //window.addEventListener('click', function (e) {
      //  const dropdown = document.getElementById('dropdownMenu');
      //  const avatar = document.getElementById('avatarDropdown');
      //  if (!avatar.contains(e.target)) {
      //    dropdown.classList.add('hidden');
      //  }
      //});

      // Chiude il menu se clicchi altrove
      window.addEventListener('click', function (e) {
        const dropdown = document.getElementById('dropdownMenu');
        const avatar = document.getElementById('avatarDropdown');
        const button = document.getElementById('profilebutton');

        if (!avatar.contains(e.target)) {
          dropdown.classList.add('hidden');
          button.classList.remove(
            'bg-neutral-800',
            'text-neutral-50',
            'dark:bg-neutral-50',
            'dark:text-neutral-800'
          );
        }
      });


      // Applica il tema al caricamento
      document.addEventListener('DOMContentLoaded', () => {
        const storedTheme = localStorage.getItem('theme') || 'auto';
        applyTheme(storedTheme);
      });
    </script>

