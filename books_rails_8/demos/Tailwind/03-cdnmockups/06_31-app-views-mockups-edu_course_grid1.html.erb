<!-- Course Grid (Tailwind CSS version) -->
<section class="py-12 bg-white">
  <div class="container mx-auto px-4">
    <!-- Title -->
    <div class="text-center mb-12">
      <h1 class="text-3xl font-bold text-gray-800">Course Grid Classic</h1>
      <nav class="text-sm breadcrumbs text-gray-500 mt-2">
        <ol class="inline-flex space-x-1">
          <li><a href="#" class="hover:underline">Home</a></li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-700 font-medium">Courses classic</li>
        </ol>
      </nav>
    </div>

    <!-- Search and filter row -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 gap-4">
      <form class="flex flex-1 border rounded-md overflow-hidden">
        <input type="text" class="w-full px-4 py-2 text-gray-700 focus:outline-none" placeholder="Find your course">
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white hover:bg-blue-700"><i class="fas fa-search"></i></button>
      </form>
      <select class="form-select max-w-xs px-4 py-2 border rounded-md text-sm text-gray-600">
        <option>Most Viewed</option>
        <option>Recently search</option>
        <option>Most popular</option>
        <option>Top rated</option>
      </select>
      <p class="text-sm text-right text-gray-500">Showing 1-7 of 32 results</p>
    </div>

    <!-- Course Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
      <!-- Course Card -->
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <img src="assets/images/courses/4by3/08.jpg" alt="course image" class="w-full h-48 object-cover">
        <div class="p-5">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-semibold text-purple-700 bg-purple-100 px-2 py-1 rounded">All level</span>
            <i class="far fa-heart text-gray-400 hover:text-red-500 cursor-pointer"></i>
          </div>
          <h5 class="text-lg font-semibold text-gray-800 mb-1 hover:text-blue-600 cursor-pointer">Sketch from A to Z: for app designer</h5>
          <p class="text-sm text-gray-500 mb-3 truncate">Proposal indulged no do sociable he throwing settling.</p>
          <div class="flex items-center text-yellow-400 text-sm space-x-1">
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="far fa-star"></i>
            <span class="ml-2 text-gray-600">4.0/5.0</span>
          </div>
        </div>
        <div class="px-5 py-3 border-t text-sm text-gray-500 flex justify-between">
          <span><i class="far fa-clock text-red-500 mr-1"></i>12h 56m</span>
          <span><i class="fas fa-table text-orange-500 mr-1"></i>15 lectures</span>
        </div>
      </div>

      <!-- Altri blocchi simili possono essere aggiunti qui -->

    </div>
  </div>
</section>
